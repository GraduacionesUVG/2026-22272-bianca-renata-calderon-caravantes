APP_ENV=development
PORT=8080

# PostgreSQL
DATABASE_URL=postgres://gymify:password@localhost:5432/gymify?sslmode=disable

# JWT
JWT_SECRET=una-clave-secreta-para-desarrollo

# Orígenes web que pueden llamar a la API, separados por comas. Si se deja
# vacío se permiten el frontend de Netlify y Expo Web en http://localhost:8081.
CORS_ALLOWED_ORIGINS=

# Zona horaria de la app: define cuándo empieza cada día y semana (racha).
APP_TIMEZONE=America/Guatemala

# Clave para proteger los códigos de recuperación de contraseña.
# Genera una con: openssl rand -hex 32
PASSWORD_RESET_SECRET=una-clave-secreta-para-desarrollo

# Recuperación de contraseña. Ponla en false si el hosting no permite SMTP
# (p. ej. Render gratuito): los endpoints responden 503 y no se exige SMTP.
PASSWORD_RESET_ENABLED=true

# SMTP (recuperación de contraseña). Si SMTP_HOST está vacío, en desarrollo
# los correos se imprimen en el log del servidor. En producción es obligatorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Gymify <no-reply@gymify.app>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
